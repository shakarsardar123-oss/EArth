plugins {
    id "com.android.application"
    id "kotlin-android"
    id "dev.flutter.flutter-gradle-plugin"
}

def localProperties = new Properties()
def localPropertiesFile = rootProject.file('local.properties')
if (localPropertiesFile.exists()) {
    localPropertiesFile.withReader('UTF-8') { reader ->
        localProperties.load(reader)
    }
}

def flutterVersionCode = localProperties.getProperty('flutter.versionCode')
if (flutterVersionCode == null) {
    flutterVersionCode = '1'
}

def flutterVersionName = localProperties.getProperty('flutter.versionName')
if (flutterVersionName == null) {
    flutterVersionName = '1.0'
}

android {
    namespace "com.texo.texo"
    compileSdk 36

    compileOptions {
        coreLibraryDesugaringEnabled true
        sourceCompatibility JavaVersion.VERSION_1_8
        targetCompatibility JavaVersion.VERSION_1_8
    }

    kotlinOptions {
        jvmTarget = '1.8'
    }

    sourceSets {
        main.java.srcDirs += 'src/main/kotlin'
    }

    defaultConfig {
        applicationId "com.texo.texo"
        minSdkVersion flutter.minSdkVersion
        targetSdk 34
        versionCode flutterVersionCode.toInteger()
        versionName flutterVersionName
    }

    buildTypes {
        release {
            signingConfig signingConfigs.debug
            minifyEnabled false
            shrinkResources false
        }
    }

    // The Vosk acoustic KWS model files under
    // src/main/assets/vosk-model-small-en-us-0.15/ are copied out to internal
    // storage at runtime and read by native code. Keep them uncompressed so
    // the copy is a straight byte stream (and so large .fst/.mdl files are not
    // re-inflated on every launch).
    androidResources {
        noCompress 'mdl', 'fst', 'int', 'dubm', 'ie', 'mat', 'stats', 'conf'
    }
}

flutter {
    source '../..'
}

dependencies {
    coreLibraryDesugaring 'com.android.tools:desugar_jdk_libs:2.1.5'

    // Real on-device acoustic keyword spotting for the "Hey AURA" wake word.
    // Vosk (Kaldi-based) runs fully offline; Apache 2.0 licensed. The bundled
    // model lives in src/main/assets/vosk-model-small-en-us-0.15/.
    implementation 'com.alphacephei:vosk-android:0.3.47'
}
